Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # LiteSpeed/Hostinger Cache Manager: bypass server-side page caching for the
  # SPA shell, route fallbacks and unversioned public files. Only fingerprinted
  # Vite assets under /assets/ are eligible for long-lived caching.
  <IfModule LiteSpeed>
    RewriteCond %{REQUEST_URI} !^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(?:js|css|mjs|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|wasm)$ [NC]
    RewriteRule .* - [E=Cache-Control:no-cache]
  </IfModule>

  # API requests must reach the configured backend origin. Do not serve index.html
  # for a missing or misconfigured /api request.
  RewriteRule ^api(?:/|$) - [L]

  # Preserve real files and directories (JS, CSS, images, favicon, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router history fallback for direct links and browser refreshes.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Default policy: content without a fingerprint must be revalidated so a new
  # deployment is visible on the next normal navigation, without a hard refresh.
  Header unset Cache-Control
  Header always unset Cache-Control
  Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  Header always set Pragma "no-cache"
  Header always set Expires "0"

  # The SPA shell must never be served from a stale browser/CDN cache. Every
  # frontend route is rewritten to index.html and receives this file policy.
  <FilesMatch "(?i)\.html?$">
    Header unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header unset Pragma
    Header always unset Pragma
    Header always set Pragma "no-cache"
    Header unset Expires
    Header always unset Expires
    Header always set Expires "0"
  </FilesMatch>

  # Vite emits content-hashed filenames for build assets. They are safe to cache
  # for one year because every code change produces a different filename and
  # the uncached HTML shell references the new filenames after deployment.
  <FilesMatch "^[^/]+-[A-Za-z0-9_-]{8,}\.(?:js|css|mjs|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|wasm)$">
    Header unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
    Header always unset Pragma
    Header unset Expires
    Header always unset Expires
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
