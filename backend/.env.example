NODE_ENV=development
PORT=4000

# Supabase PostgreSQL
# Copy the server-side connection string from Supabase Dashboard → Connect.
# For production, prefer the Supavisor/pooler connection recommended by Supabase.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase project
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="replace-with-server-only-supabase-secret-key"
SUPABASE_STORAGE_BUCKET="tcare-media"

FRONTEND_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Gmail SMTP — use a dedicated T-CARE sender Gmail account.
# Generate a Google App Password after enabling 2-Step Verification.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Email OTP policy
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# One-time ADMIN account provisioner (never used by public registration).
# Set these privately, then run: npm run admin:provision
ADMIN_EMAIL=""
ADMIN_FULL_NAME="T-CARE Administrator"
ADMIN_INITIAL_PASSWORD="" # Leave blank to generate a one-time random password during provisioning.

# Payment gateway (server-side only)
BOOKING_CONVENIENCE_FEE="0"
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-server-only-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-dedicated-webhook-secret"
PAYMENT_WEBHOOK_TOLERANCE_SECONDS="300"

# Preferred production email delivery on Render Free (HTTP API; SMTP ports are blocked).
# Create a free Brevo account, verify a sender, then set these on Render.
BREVO_API_KEY=""
EMAIL_FROM_EMAIL=""
EMAIL_FROM_NAME="T-CARE"
