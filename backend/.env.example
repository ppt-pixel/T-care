NODE_ENV=development
PORT=4000

# Supabase PostgreSQL: use Shared Pooler SESSION mode (port 5432), or a direct IPv6-capable URI.
# Do not use the Shared/Transaction Pooler URI on port 6543 with this single DATABASE_URL setup.
# Replace PROJECT_REF, DATABASE_PASSWORD and the region with the values for your own project.
# SESSION mode (port 5432)
# PROJECT_REF.pooler.supabase.com:5432
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=tcare-media
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BREVO_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=T-CARE
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_RESET_PASSWORD=
BOOKING_CONVENIENCE_FEE=0

# Payment features are fail-closed by default. Add provider credentials only to the server environment.
PAYMENTS_ENABLED=false
# Keep false until the Store migration is applied and the complete Store payment/refund flow is verified.
STORE_CHECKOUT_ENABLED=false
# Keep false until Razorpay enables QR Codes for this merchant and Test Mode validation passes.
RAZORPAY_QR_ENABLED=false
RAZORPAY_SUBSCRIPTIONS_ENABLED=false
PAYMENT_PROVIDER=razorpay
# Use test for local/isolated staging; use live only on the production service.
# This is independent of NODE_ENV so HTTPS staging keeps production cookie/security behaviour.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_A_DEDICATED_WEBHOOK_SECRET
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
