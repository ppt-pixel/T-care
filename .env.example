# Local Vite development only. On Netlify production, leave VITE_API_BASE_URL unset
# so /api/* uses the same-origin proxy in public/_redirects.
VITE_API_BASE_URL="http://localhost:4000"

# Public WhatsApp business number in international digits only, e.g. 91XXXXXXXXXX.
VITE_WHATSAPP_NUMBER=""
VITE_PUBLIC_CONTACT_EMAIL=""
VITE_PUBLIC_PHONE_NUMBER=""
VITE_PUBLIC_LOCATION=""
VITE_PUBLIC_OFFICE_ADDRESS=""
# Optional public social profile URLs. Only valid HTTPS links are displayed.
VITE_INSTAGRAM_URL=""
VITE_YOUTUBE_URL=""
VITE_FACEBOOK_URL=""
VITE_LINKEDIN_URL=""
