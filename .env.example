# Frontend Vite configuration. Local default is localhost.
# Hostinger production: set VITE_API_BASE_URL to the actual HTTPS backend origin before npm run build.
# Netlify same-origin proxy: leave VITE_API_BASE_URL unset in the Netlify build environment.
VITE_API_BASE_URL=http://localhost:4000
VITE_WHATSAPP_NUMBER=
VITE_PUBLIC_PHONE_NUMBER=
VITE_PUBLIC_LOCATION=
VITE_PUBLIC_OFFICE_ADDRESS=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_FACEBOOK_URL=
VITE_LINKEDIN_URL=
